{
  "services": [
    {
      "name": "timer-service",
      "source": "./services/timer-service",
      "variables": {
        "PORT": "3002",
        "REDIS_URL": "${{Redis.REDIS_URL}}",
        "REDIS_KEY_PREFIX": "darwin-timer",
        "TIMER_DEFAULT_DURATION": "600000",
        "TIMER_UPDATE_INTERVAL": "1000",
        "INSTANCE_ID": "timer-service-railway"
      }
    },
    {
      "name": "solana-monitor-service",
      "source": "./services/solana-monitor-service",
      "variables": {
        "PORT": "3001",
        "HELIUS_API_KEY": "${{HELIUS_API_KEY}}",
        "NEXT_PUBLIC_HELIUS_API_KEY": "${{HELIUS_API_KEY}}",
        "TOKEN_ADDRESS": "${{TOKEN_ADDRESS}}",
        "SOLANA_POLLING_INTERVAL": "60000",
        "HELIUS_WEBHOOK_MODE": "${{HELIUS_WEBHOOK_MODE}}",
        "HELIUS_WEBHOOK_URL": "${{HELIUS_WEBHOOK_URL}}",
        "INSTANCE_ID": "solana-monitor-railway",
        "TIMER_SERVICE_URL": "${{timer-service.RAILWAY_PUBLIC_DOMAIN}}"
      }
    }
  ]
}
